# 6.3.0 Step 1 spike (branch spike/connector only): the connector from source, like the app's Dockerfile.
FROM node:22-trixie-slim
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --prod --frozen-lockfile --filter "@3d-maker-suite/connector..."
ENV NODE_ENV=production APP_DATA_DIR=/data APP_INSTALL=docker
VOLUME /data
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s \
  CMD ["node", "-e", "fetch('http://127.0.0.1:4301/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
COPY spike/connector/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
WORKDIR /app/apps/connector
CMD ["node", "src/main.ts"]
