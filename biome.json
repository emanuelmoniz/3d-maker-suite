{
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!.claude", "!pnpm-lock.yaml", "!**/*.svg"]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "linter": {
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Combobox"] }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@3d-maker-suite/adapter-*"],
                "message": "Vendor adapters are imported only by the two registries, apps/server/src/integrations/registry.ts and apps/connector/src/sources/registry.ts (ADR-0003, ADR-0015)."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/server/src/integrations/registry.ts",
        "apps/connector/src/sources/registry.ts",
        "apps/server/src/**/*.test.ts",
        "apps/connector/src/**/*.test.ts"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ]
}
