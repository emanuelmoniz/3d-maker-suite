{
  "name": "3d-maker-suite",
  "private": true,
  "version": "6.2.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "speed:check": "node scripts/speed-check.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @3d-maker-suite/web build && pnpm guide:build && playwright test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "wiki:check": "node scripts/wiki-check.mjs",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "guide:build": "node scripts/guide-build.mjs",
    "docs:preview": "vitepress preview site",
    "version:check": "node scripts/version-check.mjs",
    "db:generate": "pnpm --filter @3d-maker-suite/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @3d-maker-suite/server exec tsx src/db-cli.ts migrate",
    "db:seed": "pnpm --filter @3d-maker-suite/server exec tsx src/db-cli.ts seed",
    "user:reset-password": "pnpm --filter @3d-maker-suite/server exec tsx src/db-cli.ts reset-password",
    "screenshots": "pnpm --filter @3d-maker-suite/web build && playwright test -c playwright.screenshots.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.64.0",
    "sharp": "0.34.5",
    "typescript": "^5.9.0",
    "vitepress": "1.6.4",
    "vitest": "^3.2.0"
  }
}
