{
  "name": "3d-maker-suite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "start": "pnpm --filter @3d-maker-suite/web build && pnpm --filter @3d-maker-suite/server start",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "i18n:check": "node scripts/i18n-check.mjs",
    "db:generate": "pnpm --filter @3d-maker-suite/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @3d-maker-suite/server exec tsx src/db-cli.ts migrate",
    "db:seed": "pnpm --filter @3d-maker-suite/server exec tsx src/db-cli.ts seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
